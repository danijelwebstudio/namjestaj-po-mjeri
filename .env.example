# Demo works immediately without this file. Copy to .env.local to configure live mode.
VITE_DATA_MODE=demo
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
VITE_TURNSTILE_SITE_KEY=YOUR_PUBLIC_SITE_KEY
VITE_PRIVACY_URL=https://YOUR_DOMAIN/privacy
# NEVER put service_role or TURNSTILE_SECRET_KEY in a VITE variable.
